# Normalize line endings.
* text=auto eol=lf

# Swift / Apple sources
*.swift   text diff=swift
*.h       text
*.m       text
*.plist   text
*.xcconfig text
*.entitlements text
*.strings  text

# Xcode project files are GENERATED from project.yml by XcodeGen and are not tracked
# (see .gitignore). No merge driver is declared for *.pbxproj on purpose: `merge=union`
# concatenates both sides of a conflict, which silently produces duplicate objects and a
# corrupt project file. If a .pbxproj is ever committed again, let conflicts fail loudly.
project.yml text

# Docs / config
*.md       text diff=markdown
*.yml      text
*.yaml     text
*.json     text

# Binary assets
*.png      binary
*.jpg      binary
*.jpeg     binary
*.pdf      binary
*.icns     binary
